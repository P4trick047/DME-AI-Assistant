# ============================================================
# DME AI Assistant — Git Ignore Rules
# ============================================================

# Environment & secrets
.env
*.env.local

# Python
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
venv/
env/
.venv/
*.egg-info/
dist/
build/
.eggs/

# Data (too large / contains PHI)
data/chroma_db/
data/conversations/
data/uploads/
data/docs/
data/*.log

# Jupyter
.ipynb_checkpoints/
*.ipynb

# OS
.DS_Store
Thumbs.db
*.swp
*.swo

# IDE
.vscode/
.idea/
*.code-workspace

# Streamlit
.streamlit/secrets.toml

# Keep these empty folders tracked
!data/docs/.gitkeep
!data/chroma_db/.gitkeep
!data/conversations/.gitkeep
!data/uploads/.gitkeep
