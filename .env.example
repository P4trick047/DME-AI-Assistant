# ============================================================
# .env.example  —  copy to .env for local development
# For Streamlit Cloud: paste into Settings → Secrets instead
# ============================================================

# ── Groq API key (FREE at console.groq.com) ──────────────────
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Active Groq model IDs (March 2026)
# llama-3.1-8b-instant     → fast, best for general billing Q&A
# llama-3.3-70b-versatile  → highest quality, best for analysis
GROQ_MODEL=llama-3.1-8b-instant

# ── Ollama local settings (only used when no GROQ_API_KEY) ───
OLLAMA_BASE_URL=http://localhost:11434
DEFAULT_MODEL=llama3

# ── App ──────────────────────────────────────────────────────
APP_TITLE=DME Billing AI Assistant
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
RETRIEVAL_K=4
