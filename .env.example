# ============================================================
# .env.example — copy to .env and fill in values
# For Streamlit Cloud: use the Secrets panel instead
# ============================================================

# ── Groq API (FREE — get key at console.groq.com) ───────────
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Available free models:
#   llama3-8b-8192       fast, great quality
#   llama3-70b-8192      best quality, slower
#   mixtral-8x7b-32768   large 32k context
#   gemma2-9b-it         lightweight
GROQ_MODEL=llama3-8b-8192

# ── Ollama (local only — leave blank on Streamlit Cloud) ─────
OLLAMA_BASE_URL=http://localhost:11434
DEFAULT_MODEL=llama3

# ── App ──────────────────────────────────────────────────────
APP_TITLE=DME Billing AI Assistant
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
RETRIEVAL_K=4
